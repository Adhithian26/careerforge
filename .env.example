# CareerForge AI Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# Local SQLite default: sqlite:///./careerforge.db
# Production PostgreSQL example: postgresql+psycopg2://user:password@cloudsql-host/careerforge
DATABASE_URL=sqlite:///./careerforge.db

# Authentication & Security
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported Gemini models: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_AI_PROVIDER=gemini

# MCP Configuration
MCP_SERVER_PORT=8080
MCP_AUTH_TOKEN=mcp_secure_token_change_in_production

# Code Execution Sandbox Limits
CODE_EXEC_TIMEOUT_SECONDS=3
MAX_CODE_LENGTH=10000
